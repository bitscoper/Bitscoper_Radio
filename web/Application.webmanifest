  "id": "/",
  "lang": "en",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "name": "Bitscoper Radio",
  "orientation": "any",
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+BitscoperRadio",
      "url": "/%s"
    }
  ],
  "scope": "/",
  "scope_extensions": [
    {
      "origin": "https://bitscoper-radio.site/",
      "type": "origin"
    }
  ],
  "screenshots": [
    {
      "src": "/Screenshots/Wide/1920x1080.png",
      "type": "image/png",
      "sizes": "1920x1080",
      "form_factor": "wide",
      "label": "Bitscoper Radio"
    },
    {
      "src": "/Screenshots/Narrow/750x1334.png",
      "type": "image/png",
      "sizes": "750x1334",
      "form_factor": "narrow",
      "label": "Bitscoper Radio"
    }
  ],
  "short_name": "B. Radio",
  "shortcuts": [
    {
      "name": "Bitscoper Radio",
      "url": "/",
