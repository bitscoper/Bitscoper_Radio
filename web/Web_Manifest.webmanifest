{
  "background_color": "#FFFFFF",
  "categories": ["music", "multimedia", "video"],
  "description": "An Icecast UI",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "/Icons/Transparent/48x48.png",
      "type": "image/png",
      "sizes": "48x48",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/72x72.png",
      "type": "image/png",
      "sizes": "72x72",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/96x96.png",
      "type": "image/png",
      "sizes": "96x96",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/128x128.png",
      "type": "image/png",
      "sizes": "128x128",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/192x192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/384x384.png",
      "type": "image/png",
      "sizes": "384x384",
      "purpose": "any"
    },
    {
      "src": "/Icons/Transparent/512x512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    }
  ],
  "id": "/",
  "lang": "en",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "name": "Bitscoper Radio",
  "orientation": "any",
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+BitscoperRadio",
      "url": "/%s"
    }
  ],
  "scope": "/",
  "scope_extensions": [
    {
      "origin": "https://radio.bitscoper.dev/"
    }
  ],
  "screenshots": [
    {
      "src": "/Assets/Images/Screenshot.jpeg",
      "type": "image/jpeg",
      "sizes": "1920x1080",
      "form_factor": "wide",
      "label": "Bitscoper Radio"
    }
  ],
  "short_name": "BR",
  "shortcuts": [
    {
      "name": "Bitscoper Radio",
      "url": "/",
      "description": "An Icecast UI",
      "icons": [
        {
          "src": "/Icons/Transparent/192x192.png",
          "type": "image/png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "start_url": "/",
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ]
    },
    "new_tab_button": {
      "url": "/"
    }
  },
  "theme_color": "#424242"
}
